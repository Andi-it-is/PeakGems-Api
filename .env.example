# DB_TYPE steuert den TypeORM-Treiber und muss zur echten Datenbank passen.
# Lokale Entwicklung: postgres
# Produktivumgebung:  mysql
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=changeme
DB_DATABASE=dev_foodreview

# Beispiel für eine MySQL-Produktivumgebung (Werte entsprechend ersetzen):
# DB_TYPE=mysql
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_USERNAME=your-mysql-user
# DB_PASSWORD=your-mysql-password
# DB_DATABASE=your-mysql-database

CORS_ORIGIN=http://localhost:9000
JWT_ACCESSTOKEN_SECRET=changeme
